import Link from "next/link";
import { BookVoiceAgent } from "../../../components/book-voice-agent";
import { getDemoReadingContent } from "../../../lib/demo-reading-content";

type ReaderPageProps = {
  params: Promise<{
    slug: string;
  }>;
};

export default async function ReaderPage({ params }: ReaderPageProps) {
  const { slug } = await params;
  const book = getDemoReadingContent(slug);
  const safeSlug = encodeURIComponent(book.slug);

  const introText = [
    book.title,
    book.subtitle,
    "Promesa al lector.",
    book.promise,
    "Iniciando lectura completa del libro.",
  ].join(". ");

  return (
    <main
      style={{
        minHeight: "100vh",
        padding: "48px 20px",
        background:
          "radial-gradient(circle at top, rgba(249,115,22,0.22), transparent 35%), #020617",
        color: "white",
      }}
    >
      <article
        style={{
          maxWidth: "980px",
          margin: "0 auto",
          borderRadius: "28px",
          padding: "36px",
          border: "1px solid rgba(255,255,255,0.14)",
          background: "rgba(15,23,42,0.94)",
          boxShadow: "0 30px 80px rgba(0,0,0,0.35)",
        }}
      >
        <p
          style={{
            margin: "0 0 10px",
            color: "#facc15",
            fontWeight: 900,
            textTransform: "uppercase",
            letterSpacing: "0.08em",
          }}
        >
          Lector interno con agente de voz
        </p>

        <h1
          style={{
            margin: "0 0 14px",
            fontSize: "clamp(34px, 6vw, 62px)",
            lineHeight: 1,
          }}
        >
          {book.title}
        </h1>

        <p
          style={{
            fontSize: "19px",
            lineHeight: 1.7,
            color: "rgba(255,255,255,0.78)",
          }}
        >
          {book.subtitle}
        </p>

        <BookVoiceAgent
          title={book.title}
          subtitle={book.subtitle}
          introText={introText}
          chapters={book.chapters}
        />

        <div
          style={{
            marginTop: "28px",
            padding: "22px",
            borderRadius: "20px",
            background: "rgba(255,255,255,0.06)",
            border: "1px solid rgba(255,255,255,0.1)",
          }}
        >
          <strong style={{ color: "#facc15" }}>Promesa:</strong>
          <p style={{ lineHeight: 1.8, marginBottom: 0 }}>
            {book.promise}
          </p>
        </div>

        <section style={{ marginTop: "34px" }}>
          {book.chapters.map((chapter) => (
            <section
              key={chapter.number}
              style={{
                marginTop: "24px",
                paddingTop: "24px",
                borderTop: "1px solid rgba(255,255,255,0.12)",
              }}
            >
              <p
                style={{
                  margin: "0 0 8px",
                  color: "#facc15",
                  fontWeight: 900,
                }}
              >
                Capítulo {chapter.number}
              </p>

              <h2
                style={{
                  margin: "0 0 12px",
                  fontSize: "28px",
                }}
              >
                {chapter.title}
              </h2>

              <p
                style={{
                  fontSize: "18px",
                  lineHeight: 1.9,
                  color: "rgba(255,255,255,0.82)",
                }}
              >
                {chapter.body}
              </p>
            </section>
          ))}
        </section>

        <div
          style={{
            marginTop: "34px",
            display: "flex",
            flexWrap: "wrap",
            gap: "14px",
          }}
        >
          <Link
            href={`/catalog/${safeSlug}/preview`}
            style={{
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              borderRadius: "999px",
              padding: "14px 22px",
              background: "rgba(255,255,255,0.08)",
              color: "white",
              border: "1px solid rgba(255,255,255,0.18)",
              textDecoration: "none",
              fontWeight: 800,
            }}
          >
            Volver al preview
          </Link>

          <Link
            href={`/summary/${safeSlug}`}
            style={{
              display: "inline-flex",
              alignItems: "center",
              justifyContent: "center",
              borderRadius: "999px",
              padding: "14px 22px",
              background: "white",
              color: "#020617",
              textDecoration: "none",
              fontWeight: 900,
            }}
          >
            Ver resumen
          </Link>
        </div>
      </article>
    </main>
  );
}